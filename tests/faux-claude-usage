#!/usr/bin/env node
// Comme le vrai CLI en --input-format stream-json : il part des la 1re ligne
// lue, sans attendre la fin de stdin (le proxy la garde ouverte pour /steer).
const __flux = process.argv[process.argv.indexOf('--input-format') + 1] === 'stream-json';
const quandPret = (f) => {
  let fait = false;
  const go = () => { if (!fait) { fait = true; f(); } };
  process.stdin.on('end', go);
  if (__flux) process.stdin.on('data', (d) => { if (String(d).includes('\n')) go(); });
};
// Faux CLI : 2 appels Bash, 1 Read, puis un `result` avec un usage connu.
const out = (o) => process.stdout.write(JSON.stringify(o) + '\n');
process.stdin.on('data', () => {});
quandPret(() => {
  out({ type: 'assistant', message: { content: [{ type: 'tool_use', name: 'Bash' }, { type: 'tool_use', name: 'Read' }] } });
  out({ type: 'assistant', message: { content: [{ type: 'tool_use', name: 'Bash', input: { command: 'cat ~/.hermes/skills/research/recherche-thai/SKILL.md' } }, { type: 'tool_use', name: 'Skill', input: { skill: 'marwell-index' } }] } });
  out({ type: 'assistant', message: { content: [{ type: 'text', text: 'ok' }] } });
  out({ type: 'result', subtype: 'success', result: 'ok', session_id: 's-test', num_turns: 3, total_cost_usd: 0.0123,
    usage: { input_tokens: 7, output_tokens: 33, cache_read_input_tokens: 1000, cache_creation_input_tokens: 200 },
    modelUsage: { 'claude-opus-5': { inputTokens: 7, outputTokens: 33, costUSD: 0.0123 } } });
  process.exit(0);
});
