#!/usr/bin/env node
// Faux CLI claude pour les tests du chainage : emet un stream-json minimal.
const out = (o) => process.stdout.write(JSON.stringify(o) + '\n');
let stdin = '';
process.stdin.on('data', (d) => { stdin += d; });
process.stdin.on('end', () => {
  out({ type: 'assistant', message: { content: [{ type: 'text', text: 'ok' }] } });
  out({ type: 'result', subtype: 'success', result: 'ok', usage: { input_tokens: 1, output_tokens: 1 } });
  process.exit(0);
});
